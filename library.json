{
    "name": "ESPressio-Timing",
    "description": "Generic high-resolution clocks with transport-independent synchronization and Observable lifecycle notifications",
    "keywords": "timing,clock,stopwatch,rtc,synchronization,discipline,drift,observer,observable,monotonic,precision,units,generic,espressio",
    "homepage": "https://espressio.org",
    "authors": {
        "name": "Simon J. Stuart",
        "maintainer": true,
        "url": "https://espressio.org"
    },
    "build": {
        "flags": [
            "-DESPRESSIO_TIMING"
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ESPressio-Development-Platform/ESPressio-Timing.git"
    },
    "version": "2.2.8",
    "license": "Apache-2.0",
    "frameworks": "arduino",
    "platforms": "*",
    "dependencies": [
        {
            "name": "ESPressio-Units",
            "version": ">=0.2.7 <1.0.0",
            "url": "https://github.com/ESPressio-Development-Platform/ESPressio-Units.git",
            "platforms": "*"
        },
        {
            "name": "ESPressio-Observable",
            "version": ">=3.0.2 <4.0.0",
            "url": "https://github.com/ESPressio-Development-Platform/ESPressio-Observable.git",
            "platforms": "*"
        }
    ]
}
