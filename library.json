    "keywords": "timing,clock,stopwatch,rtc,synchronization,discipline,drift,observer,observable,monotonic,precision,units,generic,espressio",
    "homepage": "https://espressio.org",
    "authors": {
        "name": "Simon J. Stuart",
        "maintainer": true,
        "url": "https://espressio.org"
    },
    "build": {
        "flags": ["-std=gnu++17", "-DESPRESSIO_TIMING"]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ESPressio-Development-Platform/ESPressio-Timing.git"
    },
    "version": "2.2.8",
    "license": "Apache-2.0",
    "frameworks": "*",
    "platforms": "*",
    "dependencies": [
        {
            "name": "ESPressio-System",
            "version": "https://github.com/ESPressio-Development-Platform/ESPressio-System.git#structural_realignment",
            "platforms": "*"
        },
        {
            "name": "ESPressio-Units",
            "version": "https://github.com/ESPressio-Development-Platform/ESPressio-Units.git#structural_realignment",
            "platforms": "*"
        },
        {
            "name": "ESPressio-Observable",
            "version": "https://github.com/ESPressio-Development-Platform/ESPressio-Observable.git#structural_realignment",
            "platforms": "*"
        }
    ]
